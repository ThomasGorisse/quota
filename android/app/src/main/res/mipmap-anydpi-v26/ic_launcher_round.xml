<?xml version="1.0" encoding="utf-8"?>
<!--
  Not hand-drawn: `android/scripts/generate-play-assets.py` cuts all three layers out of
  `docs/brand/icon-candidates/01-battery-q.png` — the foreground
  (mipmap-*/ic_launcher_foreground.png), the themed-icon silhouette
  (mipmap-*/ic_launcher_monochrome.png) and the 512 px Play icon — from the same crop, so
  the store listing and the home screen cannot drift. `monochrome` is a raster because the
  source mark is one: a hand-traced vector would be a second, subtly different Q.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
